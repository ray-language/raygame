// raygame — tetris in the terminal at 30 fps.
import std/random;
import app;

fn main() -> int {
    let av = args();
    for a in av {
        if (a == "--bench") {
            return app.bench();
        }
        if (a == "--seed") {
            random.seed(42);
        }
        if (a == "--help" || a == "-h") {
            eprint("usage: raygame [--bench] [--seed]");
            eprint(
                "  ←→ mover · ↑ rotar · ↓ bajar · espacio soltar · p pausa · r reiniciar · q salir"
            );
            return 0;
        }
    }
    app.play()
}
